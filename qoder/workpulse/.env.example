# WorkPulse · local demo configuration (copy to .env and adjust)
# --- seekdb (MySQL protocol) ---
WP_SEEKDB_HOST=127.0.0.1
WP_SEEKDB_PORT=2881
WP_SEEKDB_USER=root
WP_SEEKDB_PASSWORD=
WP_SEEKDB_DATABASE=workpulse

# --- PowerContext server ---
WP_PC_URL=http://127.0.0.1:8000
# Local demo token only. Generate your own for anything non-local.
WP_PC_TOKEN=workpulse-local-token
WP_PC_SCOPE_PREFIX=workpulse

# --- embeddings ---
# hash = offline deterministic embedder (default, no model download)
# openai = any OpenAI-compatible /embeddings endpoint
WP_EMBEDDING_PROVIDER=hash
WP_EMBEDDING_DIM=384
# WP_EMBEDDING_PROVIDER=openai
# WP_EMBEDDING_BASE_URL=https://api.example.com/v1
# WP_EMBEDDING_API_KEY=replace-with-your-key
# WP_EMBEDDING_MODEL=bge-m3

# --- retrieval / chunking ---
WP_FT_WEIGHT=0.45
WP_CHUNK_CHARS=320
WP_CHUNK_OVERLAP=60

# --- web server ---
WP_HOST=127.0.0.1
WP_PORT=8077
